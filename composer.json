{
    "name": "olorunda/laravel-aiface-websocket",
    "description": "TimyTeco AiFace Biometric WebSocket / WSS Server & Full Command Interaction SDK for Laravel",
    "type": "library",
    "keywords": [
        "laravel",
        "aiface",
        "timyteco",
        "websocket",
        "biometric",
        "facial-recognition",
        "fingerprint",
        "access-control",
        "time-attendance"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Olorunda"
        }
    ],
    "require": {
        "php": ">=8.1",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/events": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "AiFace\\WebSocket\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AiFace\\WebSocket\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AiFace\\WebSocket\\AiFaceServiceProvider"
            ],
            "aliases": {
                "AiFace": "AiFace\\WebSocket\\Facades\\AiFace"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
